# Discord Bot Configuration
BOT_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
OWNER_IDS=owner_id_1,owner_id_2
DEFAULT_PREFIX=!
SUPPORT_SERVER=https://discord.gg/yourserver
INVITE_LINK=https://discord.com/oauth2/authorize?client_id=your_client_id
WEBSITE=https://yourbot.com

# Spotify Credentials
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Lavalink Configuration (Multi-node support)
LAVALINK_NODES=[{"host":"localhost","port":2333,"password":"youshallnotpass","secure":false}]

# Embed Configuration
EMBED_COLOR=0x5865F2
STATUS_TYPE=LISTENING
STATUS_TEXT=Music | !help

# Webhook URLs for Logging
GUILD_JOIN_WEBHOOK=your_webhook_url
GUILD_LEAVE_WEBHOOK=your_webhook_url
PREMIUM_ADDED_WEBHOOK=your_webhook_url
PREMIUM_REMOVED_WEBHOOK=your_webhook_url
ERROR_LOGS_WEBHOOK=your_webhook_url

# Database Configuration
DATABASE_PATH=./database/bot.db

# Premium Configuration
PREMIUM_ROLE_ID=your_premium_role_id
DEFAULT_VOLUME=80

# Bot Settings
AUTO_RECONNECT=true
SHARD_COUNT=auto
CLUSTER_ENABLED=false
